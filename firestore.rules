rules_version = '2';

// Permissões do app Louvor-IBFCG — três níveis:
//
//  1. Sem conta: nenhum acesso. O app nem abre as escutas — o `authGuard`
//     manda para a tela de login (não existe login anônimo).
//  2. Membro logado (e-mail/senha): leitura + escrita em Repertório (louvores),
//     Playlists e no próprio perfil (usuarios/{uid}).
//  3. Administrador: escreve em tudo — Escala (cultos/planilhas), Participantes,
//     Kits musicais e Mensagens.
//
// Os administradores ficam na coleção `admins` (id = uid do usuário, dados
// livres: nome, email, criadoEm...). Podem ser criados no Console do
// Firebase ou promovidos pelo próprio app por outro administrador — as
// regras exigem que quem escreve já seja admin (nada de auto-promoção).
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // Quem entrou com e-mail/senha. O teste de provedor fica como trava
    // extra: um eventual token anônimo não passa daqui.
    function membro() {
      return autenticado() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Administrador: existe um doc em admins/{uid} com este uid.
    function admin() {
      return autenticado() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Áudio/vídeo em partes no Firestore (o projeto não usa Firebase Storage).
    // O id do documento é o caminho com "/" trocado por "|"
    // ("kits|kit1|a.wav", "louvores|l1|a.mp3") e as regras decidem por ele.
    function podeGravarArquivo(id) {
      return (id.matches('^kits[|].*') && admin()) ||
        (id.matches('^louvores[|].*') && (admin() || membro()));
    }

    // ===== Editáveis por membros logados =====

    match /louvores/{id} {
      allow read: if autenticado();
      allow write: if membro();
    }

    match /playlists/{id} {
      allow read: if autenticado();
      allow write: if membro();
    }

    // Perfil: cada um lê (para exibir nomes) e escreve o próprio documento.
    match /usuarios/{uid} {
      allow read: if autenticado();
      allow create, update: if membro() && request.auth.uid == uid;
      allow delete: if admin();
    }

    // ===== Somente administradores alteram =====

    match /cultos/{id} {
      allow read: if autenticado();
      allow write: if admin();
    }

    match /planilhas/{id} {
      allow read: if autenticado();
      allow write: if admin();
    }

    match /participantes/{id} {
      allow read: if autenticado();
      allow write: if admin();
    }

    match /kits/{id} {
      allow read: if autenticado();
      allow write: if admin();
    }

    match /mensagens/{id} {
      allow read: if autenticado();
      allow write: if admin();
    }

    // Áudios dos kits e do Repertório guardados em partes (sem Storage).
    // `arquivos/{id}` tem os metadados; `partes/{n}` tem os pedaços < 1 MB.
    match /arquivos/{arquivoId} {
      allow read: if autenticado();
      allow write: if podeGravarArquivo(arquivoId);

      match /partes/{parteId} {
        allow read: if autenticado();
        allow write: if podeGravarArquivo(arquivoId);
      }
    }

    // Lista de administradores: membros leem (o app exibe o selo de admin e
    // a lista de promovíveis); a escrita exige já ser administrador — quem
    // tem um doc em admins/{request.auth.uid} promove ou remove os outros,
    // então não existe auto-promoção pelo app. O Console continua valendo
    // como caminho de emergência (bypassa as regras).
    match /admins/{uid} {
      allow read: if membro();
      allow write: if admin();
    }

    // Coleções desconhecidas: leitura para quem está logado, escrita negada.
    match /{colecao}/{id} {
      allow read: if autenticado();
      allow write: if false;
    }
  }
}
