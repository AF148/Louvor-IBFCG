{
    "version": 2,
    "builds": [
      {
        "src": "api/*.js",
        "use": "@vercel/node",
        "config": { "maxDuration": 30 }
      }
    ],
    "routes": [
      {
        "src": "/",
        "dest": "/api/index.js"
      },
      {
        "src": "/api/cifra-club-2",
        "dest": "/api/cifra.js"
      },
      {
        "src": "/api/cifra",
        "dest": "/api/cifra.js"
      }
    ]
  }
